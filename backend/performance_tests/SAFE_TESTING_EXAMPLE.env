# Safe Performance Testing Configuration
# Copy this to .env in backend/ directory

# ============================================
# SAFETY SETTINGS (IMPORTANT!)
# ============================================

# Enable read-only mode to prevent any data creation
# This is the SAFEST option - only tests read endpoints
PERFORMANCE_TEST_READ_ONLY=true

# OR disable specific write operations individually:
# PERFORMANCE_TEST_DISABLE_REGISTRATION=true
# PERFORMANCE_TEST_DISABLE_CLASS_CREATE=true
# PERFORMANCE_TEST_DISABLE_NOTIFICATIONS=true
# PERFORMANCE_TEST_DISABLE_SHEET_WRITES=true

# ============================================
# TEST CONFIGURATION
# ============================================

# Authentication - Choose ONE option:

# OPTION 1: Use pre-obtained JWT token (RECOMMENDED for Google/Firebase auth users)
# Get token from browser console: localStorage.getItem('authToken')
# Or from DevTools > Application > Local Storage > authToken
TEST_USER_TOKEN=your-jwt-token-here

# OPTION 2: Use email/password (only if email/password login is enabled)
# TEST_USER_EMAIL=your-test-email@example.com
# TEST_USER_PASSWORD=your-test-password

# Test Google Sheets IDs (use TEST sheets only, not production!)
TEST_SHEET_IDS=test_sheet_id_1,test_sheet_id_2

# API URL (consider using staging environment!)
PERFORMANCE_TEST_API_URL=https://vocalyx-backend-64846917574.asia-southeast1.run.app

# ============================================
# LOAD LIMITS (Prevent excessive load)
# ============================================

# Maximum concurrent users
PERFORMANCE_TEST_MAX_USERS=50

# Maximum test duration in minutes
PERFORMANCE_TEST_MAX_DURATION_MINUTES=10

# ============================================
# TEST DATA CLEANUP
# ============================================

# Prefix for test data (makes cleanup easier)
PERFORMANCE_TEST_DATA_PREFIX=test_perf_

# After testing, you can clean up test data with:
# python manage.py shell
# >>> from users.models import CustomUser
# >>> CustomUser.objects.filter(email__startswith='test_perf_').delete()

